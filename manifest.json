{
  "id": "com.jeremy.tavo-memory-curator",
  "name": {
    "$t": "plugin.name"
  },
  "version": "0.7.0-beta.4",
  "specVersion": 2,
  "minAppVersion": "0.91.0",
  "author": "Jeremy",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json"
    }
  },
  "permissions": [
    "memory",
    "generate",
    "variable"
  ],
  "contributes": {
    "htmlFragments": [
      {
        "id": "memory-curator-panel",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      }
    ],
    "sidebar": [
      {
        "id": "open-memory-curator",
        "label": {
          "$t": "actions.openMemoryCurator"
        }
      }
    ]
  },
  "releaseNotes": "Attempt verified rollback after memory update or verification exceptions; correct sidebar navigation instructions.",
  "entry": "entry.js"
}
