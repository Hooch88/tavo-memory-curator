{
  "id": "com.jeremy.tavo-memory-curator",
  "name": {
    "$t": "plugin.name"
  },
  "version": "0.7.0-beta.2",
  "specVersion": 2,
  "minAppVersion": "0.91.0",
  "author": "Jeremy",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json"
    }
  },
  "permissions": [
    "memory",
    "generate",
    "variable"
  ],
  "contributes": {
    "htmlFragments": [
      {
        "id": "memory-curator-panel",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      }
    ]
  },
  "releaseNotes": "Keep panel and draggable launcher within Tavo layout insets; pass native request timeouts; reject stale proposals when memories changed after review."
}
